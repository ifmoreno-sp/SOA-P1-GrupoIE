# Build artifacts
build/
build-asan/
build-tsan/
lottery_scheduler
*.o
*.out

# Resultados generados por experimentos (no versionar corridas masivas)
results/*
!results/.gitkeep

# Excepcion: resultados seleccionados del experimento de proporcionalidad
# (M11/Issue #13) -- se versionan para que las graficas queden visibles
# directo en el PR, aunque el experimento sea reproducible corriendo
# scripts/experimento_proporcionalidad.py.
!results/proporcionalidad/
!results/proporcionalidad/*.png
!results/proporcionalidad/*.csv

# Python (scripts/casos_enunciado/*.py)
__pycache__/
*.pyc

# Artefactos de compilacion de docs/informe/main.tex (el PDF final va en
# docs/informe.pdf, generado y versionado aparte -- ver docs/informe/README.md)
docs/informe/*.aux
docs/informe/*.bbl
docs/informe/*.blg
docs/informe/*.fdb_latexmk
docs/informe/*.fls
docs/informe/*.log
docs/informe/*.out
docs/informe/*.synctex.gz
docs/informe/main.pdf

# macOS
.DS_Store

# Editores
.vscode/
*.swp
